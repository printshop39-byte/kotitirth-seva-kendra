  "sections": [
    {
      "type": "heading",
      "lines": [
        "१९. ॥ श्री रामरक्षा ॥"
      ]
    },
    {
      "type": "mantra",
      "lines": [
        "॥ श्री गणेशाय नमः ॥"
      ]
    },
    {
      "type": "prose",
      "lines": [
        "ॐ अस्य श्रीरामरक्षास्तोत्रमंत्रस्य । बुधकौशिक ऋषि: ।",
        "श्रीसीतारामचन्द्रो देवता । अनुष्टुप् छंद: । सीता शक्ति: श्रीमद्धनुमान् कीलकम् ।",
        "श्रीरामचन्द्रप्रीत्यर्थे रामरक्षास्तोत्रजपे विनियोग: ॥"
      ]
    },
    {
      "type": "heading",
      "lines": [
        "अथ ध्यानम् ।"
      ]
    },
    {
      "type": "verse",
      "lines": [
        "ध्यायेदाजानुबाहुं धृतशरधनुषं बद्धपद्मासनस्थं ।",
        "पीतं वासो वसानं नवकमलदल स्पर्धिनेत्रं प्रसन्नम् ॥",
        "वामांकारूढसीतामुखकमलमिल्लोचनं नीरदाभं ।",
        "नानाऽलंकारदीप्तं दधतमुरुजटामण्डनं रामचन्द्रम् ॥१॥"
      ]
    },
    {
      "type": "note",
      "lines": [
        "इति ध्यानम् ।"
      ]
    },
    {
      "type": "verse",
      "number": "१",
      "lines": [
        "चरितं रघुनाथस्य शतकोटिप्रविस्तरम् ।",
        "एकैकमक्षरं पुंसां महापातकनाशनम् ॥१॥"
      ]
    },
    {
      "type": "verse",
      "number": "२",
      "lines": [
        "ध्यात्वा नीलोत्पलश्यामं रामं राजीवलोचनम् ।",
        "जानकीलक्ष्मणोपेतं जटामुकुट मण्डितम् ॥२॥"
      ]
    },
    {
      "type": "verse",
      "number": "३",
      "lines": [
        "सासितूणधनुर्बाणपाणिं नक्तंचरान्तकम् ।",
        "स्वलीलया जगत्त्रातुमाविर्भूतमजं विभुम् ॥३॥"
      ]
    },
    {
      "type": "verse",
      "number": "४",
      "lines": [
        "रामरक्षां पठेत्प्राज्ञ: पापघ्नीं सर्वकामदाम् ।",
        "शिरो मे राघव: पातु, भालं दशरथात्मज: ॥४॥"
      ]
    },
    {
      "type": "verse",
      "number": "५",
      "lines": [
        "कौसल्येयो दृशौ पातु, विश्वामित्रप्रिय: श्रुती ।",
        "घ्राणं पातु मखत्राता मुखं सौमित्रिवत्सल: ॥५॥"
      ]
    },
    {
      "type": "verse",
      "number": "६",
      "lines": [
        "जिह्वां विद्यानिधि: पातु, कण्ठं भरतवन्दित: ।",
        "स्कन्धौ दिव्यायुध: पातु, भुजौ भग्नेशकार्मुक: ॥६॥"
      ]
    },
    {
      "type": "verse",
      "number": "७",
      "lines": [
        "करौ सीतापति: पातु, हृदयं जामदग्न्यजित् ।",
        "मध्यं पातु खरध्वंसी, नाभिं जाम्बवदाश्रय: ॥७॥"
      ]
    },
    {
      "type": "verse",
      "number": "८",
      "lines": [
        "सुग्रीवेश: कटी पातु, सक्थिनी हनुमत्प्रभु: ।",
        "ऊरू रघुत्तम: पातु, रक्ष: कुलविनाशकृत् ॥८॥"
      ]
    },
    {
      "type": "verse",
      "number": "९",
      "lines": [
        "जानुनी सेतुकृत्पातु, जङ्घे दशमुखान्तक: ।",
        "पादौ बिभीषणश्रीद: पातु, रामोऽखिलं वपु: ॥९॥"
      ]
    },
    {
      "type": "verse",
      "number": "१०",
      "lines": [
        "एतां रामबलोपेतां रक्षां य: सुकृती पठेत् ।",
        "स चिरायु: सुखी पुत्री विजयी विनयी भवेत् ॥१०॥"
      ]
    },
    {
      "type": "verse",
      "number": "११",
      "lines": [
        "पातालभूतलव्योम चारिणश्छद्मचारिण: ।",
        "न द्रष्टुमपि शक्तास्ते रक्षितं रामनामभि: ॥११॥"
      ]
    },
    {
      "type": "verse",
      "number": "१२",
      "lines": [
        "रामेति रामभद्रेति रामचन्द्रेति वा स्मरन् ।",
        "नरो न लिप्यते पापैर् भुक्ति मुक्ति च विन्दति ॥१२॥"
      ]
    },
    {
      "type": "verse",
      "number": "१३",
      "lines": [
        "जगज्जैत्रैकमन्त्रेण रामनाम्नाऽभिरक्षितम् ।",
        "य: कण्ठे धारयेत्तस्य करस्था: सर्वसिद्धय: ॥१३॥"
      ]
    },
    {
      "type": "verse",
      "number": "१४",
      "lines": [
        "वज्रपंजरनामेदं यो रामकवचं स्मरेत् ।",
        "अव्याहताज्ञ: सर्वत्र लभते जयमङ्गलम् ॥१४॥"
      ]
    },
    {
      "type": "verse",
      "number": "१५",
      "lines": [
        "आदिष्टवान्यथा स्वप्ने रामरक्षामिमांहर: ।",
        "तथा लिखितवान्प्रात: प्रबुद्धो बुधकौशिक: ॥१५॥"
      ]
    },
    {
      "type": "verse",
      "number": "१६",
      "lines": [
        "आराम: कल्पवृक्षाणां विराम: सकलापदाम् ।",
        "अभिरामस्त्रिलोकानां राम: श्रीमान् स न: प्रभु: ॥१६॥"
      ]
    },
    {
      "type": "verse",
      "number": "१७",
      "lines": [
        "तरुणौ रुपसंपन्नौ सुकुमारौ महाबलौ ।",
        "पुण्डरीकविशालाक्षौ चीरकृष्णाजिनाम्बरौ ॥१७॥"
      ]
    },
    {
      "type": "verse",
      "number": "१८",
      "lines": [
        "फलमूलाशिनौ दान्तौ तापसौ ब्रह्मचारिणौ ।",
        "पुत्रौ दशरथस्यैतो भ्रातरौ रामलक्ष्मणौ ॥१८॥"
      ]
    },
    {
      "type": "verse",
      "number": "१९",
      "lines": [
        "शरण्यौ सर्वसत्त्वानां श्रेष्ठौ सर्वधनुष्मताम् ।",
        "रक्ष:कुलनिहन्तारौ त्रायेतां नो रघूत्तमौ ॥१९॥"
      ]
    },
    {
      "type": "verse",
      "number": "२०",
      "lines": [
        "आत्तसज्यधनुषाविषुस्पृशावक्षयाशुगनिषंगसंगिनौ ।",
        "रक्षणाय मम रामलक्ष्मणावग्रत: पथि सदैव गच्छताम् ॥२०॥"
      ]
    },
    {
      "type": "verse",
      "number": "२१",
      "lines": [
        "संनद्ध: कवची खड्गी चापबाणधरो युवा ।",
        "गच्छन्मनोरथोऽस्माकं राम: पातु सलक्ष्मण: ॥२१॥"
      ]
    },
    {
      "type": "verse",
      "number": "२२",
      "lines": [
        "रामो दाशरथि: शूरो लक्ष्मणानुचरो बली ।",
        "काकुत्स्थ: पुरुष: पूर्ण: कौसल्येयो रघूत्तम: ॥२२॥"
      ]
    },
    {
      "type": "verse",
      "number": "२३",
      "lines": [
        "वेदान्तवेद्यो यज्ञेश: पुराण पुरुषोत्तम: ।",
        "जानकीवल्लभ: श्रीमानप्रमेयपराक्रम: ॥२३॥"
      ]
    },
    {
      "type": "verse",
      "number": "२४",
      "lines": [
        "इत्येतानि जपन् नित्यं मद्भक्त: श्रद्धयाऽन्वित: ।",
        "अश्वमेधाधिकं पुण्यं संप्राप्नोति न संशय: ॥२४॥"
      ]
    },
    {
      "type": "verse",
      "number": "२५",
      "lines": [
        "रामं दूर्वादलश्यामं पद्माक्षं पीतवाससम् ।",
        "स्तुवन्ति नामाभिर्दिव्यैरन ते संसारिणो नर: ॥२५॥"
      ]
    },
    {
      "type": "verse",
      "number": "२६",
      "lines": [
        "रामं लक्ष्मणपूर्वजं रघुवरं सीतापतिं सुन्दरम् ।",
        "काकुत्स्थं करुणार्णवं गुणनिधिं विप्रप्रियं धार्मिकम् ॥२६॥"
      ]
    },
    {
      "type": "verse",
      "number": "२७",
      "lines": [
        "राजेन्द्र सत्यसंधं दशरथतनयं श्यामलं शान्तमूर्तिं ।",
        "वन्दे लोकाभिरामं रघुकुलतिलकं राघवं रावणारिम् ॥२७॥"
      ]
    },
    {
      "type": "verse",
      "number": "२८",
      "lines": [
        "रामाय रामभद्राय रामचन्द्राय वेधसे ।",
        "रघुनाथाय नाथाय सीतायाः पतये नमः ॥२८॥"
      ]
    },
    {
      "type": "verse",
      "number": "२९",
      "lines": [
        "श्रीराम राम रघुनन्दन राम राम । श्रीराम राम भरताग्रज",
        "राम राम । श्रीराम राम रणकर्कश राम राम ।",
        "श्रीराम राम शरणं भव राम राम ॥२९॥"
      ]
    },
    {
      "type": "verse",
      "number": "३०",
      "lines": [
        "श्रीरामचन्द्रचरणौ मनसा स्मरामि । श्रीरामचन्द्रचरणौ",
        "वचसा गृणामि । श्रीरामचन्द्रचरणौ शिरसा नमामि ।",
        "श्रीरामचन्द्रचरणौ शरणं प्रपद्ये ॥३०॥"
      ]
    },
    {
      "type": "verse",
      "number": "३१",
      "lines": [
        "माता रामो मत्पिता रामचन्द्र: । स्वामी रामो मत्सखा रामचन्द्र: ॥",
        "सर्वस्वं मे रामचन्द्रो दयालुर्नान्यं जाने नैव जाने न जाने ॥३१॥"
      ]
    },
    {
      "type": "verse",
      "number": "३२",
      "lines": [
        "दक्षिणे लक्ष्मणो यस्य वामे तू जनकात्मजा ।",
        "पुरतो मारुतिर्यस्य तं वन्दे रघुनन्दनम् ॥३२॥"
      ]
    },
    {
      "type": "verse",
      "number": "३३",
      "lines": [
        "लोकाभिरामं रणरंगधीरं । राजीवनेत्रं रघुवंशनाथम् ।",
        "कारुण्यरुपं करुणाकरं तं । श्रीरामचन्द्रं शरणं प्रपद्ये ॥३३॥"
      ]
    },
    {
      "type": "verse",
      "number": "३४",
      "lines": [
        "मनोजवं मारुततुल्यवेगं । जितेन्द्रियं बुद्धिमतां वरिष्ठम् ॥",
        "वातात्मजं वानरयूथमुख्यं । श्रीरामदूतं शरणं प्रपद्ये ॥३४॥"
      ]
    },
    {
      "type": "verse",
      "number": "३५",
      "lines": [
        "कूजन्तं रामरामेति मधुरं मधुराक्षरम् ।",
        "आरुह्य कविताशाखां वन्दे वाल्मीकिकोकिलम् ॥३५॥"
      ]
    },
    {
      "type": "verse",
      "number": "३६",
      "lines": [
        "आपदामपहर्तारं दातारं सर्वसंपदाम् ।",
        "लोकाभिरामं श्रीरामं भूयो भूयो नमाम्यहम् ॥३६॥"
      ]
    },
    {
      "type": "verse",
      "number": "३७",
      "lines": [
        "भर्जनं भवबीजानामर्जनं सुखसंपदाम् ।",
        "तर्जनं यमदूतानां रामरामेति गर्जनम् ॥३७॥"
      ]
    },
    {
      "type": "verse",
      "number": "३८",
      "lines": [
        "रामो राजमणि: सदा विजयते रामं रमेशं भजे ।",
        "रामेणाभिहता निशाचरचमू रामाय तस्मै नमः ॥",
        "रामान्नास्ति परायणं परतरं रामस्य दासोऽस्म्यहं ।",
        "रामे चित्तलय: सदा भवतु मे भो राम मामुद्धर ॥३८॥"
      ]
    },
    {
      "type": "verse",
      "number": "३९",
      "lines": [
        "राम रामेति रामेति रमे रामे मनोरमे ।",
        "सहस्रनाम तत्तुल्यं रामनाम वरानने ॥३९॥"
      ]
    },
    {
      "type": "phalashruti",
      "lines": [
        "इति श्रीबुधकौशिकविरचितं श्रीरामरक्षास्तोत्रं संपूर्णम् ॥",
        "॥ श्री सीतारामचंद्रार्पणमस्तु ॥"
      ]
    }
  ]
}
