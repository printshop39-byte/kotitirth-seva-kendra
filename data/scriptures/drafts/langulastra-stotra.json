  "sections": [
    {
      "type": "heading",
      "lines": [
        "॥ ३६ ॥ श्री लांगूलास्त्र शत्रुंजय स्तोत्रम् ॥"
      ]
    },
    {
      "type": "mantra",
      "lines": [
        "ॐ हनुमन्तं महावीरं वायुतुल्यपराक्रम् । मम कार्यार्थमागच्छ प्रणमामि-मुहुर्मुहु: ॥"
      ]
    },
    {
      "type": "heading",
      "lines": [
        "विनियोग:"
      ]
    },
    {
      "type": "prose",
      "lines": [
        "ॐ अस्य श्री हनुमत् शत्रुंजयस्तोत्र मालामंत्रस्य श्रीरामचंद्र ऋषि: ।",
        "नानाछंदांसि । श्रीमन् महावीरो हनुमान देवता । मारुतात्मज इति",
        "हसौं बीजम्। अंजनीसूनुरिति हरें शक्ति:। ॐ हांहांहां इति",
        "कीलकम्। श्रीरामभक्त ह्रां इति प्राण:। श्रीरामलक्ष्मण आनंदकर",
        "ह्रां ह्रीं ह्रूं इति जीव:। ममाराति पराजय निमित्त शत्रुंजयस्तोत्र",
        "मालामंत्र जपे विनियोग:।"
      ]
    },
    {
      "type": "heading",
      "lines": [
        "करन्यास:"
      ]
    },
    {
      "type": "prose",
      "lines": [
        "ॐ ऐं श्रीं ह्रां ह्रीं ह्रूं स्फें हस्खें हसौं नमो हनुमते अंगुष्ठाभ्यां नम: ॥",
        "इति बीजादौ सर्वत्र संयोज्य रामदूताय तर्जनीभ्यां नमः ॥ लक्ष्मण",
        "प्राणदात्रे मध्यमाभ्यां नमः ॥अंजनीसूनवे अनामिकाभ्यां नमः॥",
        "सीताशोक विनाशाय कनिष्ठिकाभ्यां नमः॥ लंकाप्रासाद भंजनाय",
        "करतलकर पृष्ठाभ्यां नमः॥"
      ]
    },
    {
      "type": "heading",
      "lines": [
        "हृदयादि षडंग न्यास:"
      ]
    },
    {
      "type": "prose",
      "lines": [
        "ॐ हनुमते हृदयाय नमः। रामदूताय शिरसे स्वाहा।",
        "लक्ष्मण प्राणदात्रे शिखायै वषट्। अंजनीसूनवे कवचाय हुम्।",
        "सीताशोक विनाशिने नेत्रत्रयाय वौषट्। लंकाप्रासाद भंजनाय",
        "अस्त्राय फट्।"
      ]
    },
    {
      "type": "heading",
      "lines": [
        "ध्यान:"
      ]
    },
    {
      "type": "verse",
      "number": "१",
      "lines": [
        "ध्यायेत् बालदिवाकर द्युतिनिभं देवारि दर्पापहं",
        "देवेंद्रप्रमुखै: प्रशस्तयशसं देदीप्यमानं रुचा ॥",
        "सुग्रीवादि समस्त वानरयुतं सुव्यक्त तत्त्वप्रियं ।",
        "संरक्त अरुणलोचनं पवनजं पीतांबर अलंकृतम् ॥१॥"
      ]
    },
    {
      "type": "verse",
      "number": "२",
      "lines": [
        "मनोजवं मारुततुल्य वेगं जितेन्द्रियं बुद्धिमतां वरिष्ठम् ।",
        "वातात्मजं वानरयूथमुख्यं श्रीरामदूतं शरणं प्रपद्ये ॥२॥"
      ]
    },
    {
      "type": "verse",
      "number": "३",
      "lines": [
        "वज्रांग पिंगकेशाढ्यं स्वर्णकुंडल मंडितम् ।",
        "नियुद्धं उपसंक पारावार पराक्रमम् ॥३॥"
      ]
    },
    {
      "type": "verse",
      "number": "४",
      "lines": [
        "वामहस्तं गदायुक्तं पाशहस्तं कमंडलुम् ।",
        "उद्यद् दक्षिण दोर्दंड हनुमंतं विचिंतयेत् ॥४॥"
      ]
    },
    {
      "type": "heading",
      "lines": [
        "मालामंत्र"
      ]
    },
    {
      "type": "mantra",
      "lines": [
        "ॐ ऐं श्रीं ह्रां ह्रीं ह्रूं स्फें खें हस्खें हसौं नमो हनुमते त्रैलोक्य आक्रमण",
        "पराक्रम श्रीराम भक्त! मम परस्य च सर्वशत्रून् चतुर्वर्णसंभवान् पुं स्त्री",
        "नपुंसकान् भूत-भविष्यवर्तमान् नानादूरस्थ समीपस्थान् नाना नामधेयान्",
        "नाना संकर जातिजान् कलत्र पुत्र मित्र भृत्य बंधु सुहृत् समेतान् प्रभुशक्ति",
        "सहितान् धन धान्यादि संपत्ति युतान् राज्ञो राजपुत्रो सेवकान् मंत्रि सचिव",
        "सखिन् आत्यंतिक क्षणेन् त्वरया एताद् दिनावधि नाना उपायै मारय मारय",
        "शस्त्रै छेदय छेदय अग्निना ज्वालय ज्वालय दाहय दाहय अक्षयकुमारवत्",
        "पादतल आक्रमणेन अनेन शिलातले आत्रोटय आत्रोटय घातय घातय वध",
        "वध भूतसंघैः सह भक्षय भक्षय क्रुद्धचेतसा नखैः विदारय विदारय देशात्",
        "अस्मात् उच्चाटय उच्चाटय पिशाचवत् भ्रंशय भ्रंशय भ्रामय भ्रामय भयातुरान्",
        "विसंज्ञान् सद्यः कुरु कुरु भस्मिभूतान् उद्धूलय उद्धूलय भक्तजनवत्सल",
        "सीताशोक अपहारक सर्वत्र मामेनश्च एनं च रक्षरक्ष हांहांहां हुंहुंहुं घेघेघे",
        "हुं फट् स्वाहा ॥१॥"
      ]
    },
    {
      "type": "mantra",
      "lines": [
        "ॐ नमो हनुमते महाबल पराक्रमाय महाविपत्ति निवारकाय भक्तजन मनकाम",
        "ना कल्पद्रुमाय दुष्टजन-मनोरथ-स्तंभनाय प्रभंजन-प्राणप्रियाय स्वाहा॥",
        "ॐ ह्रां ह्रीं ह्रूं ह्रैं ह्रौं ह्र: मम शत्रून् शूलेन छेदय छेदय अग्निना ज्वालय",
        "ज्वालय दाहय दाहय उच्चाटय उच्चाटय हुं फट् स्वाहा स्वाहा स्वाहा ॥२॥"
      ]
    },
    {
      "type": "heading",
      "lines": [
        "शत्रुंजय स्तोत्रम्"
      ]
    },
    {
      "type": "mantra",
      "lines": [
        "ॐ हनुमते नमः।"
      ]
    },
    {
      "type": "verse",
      "number": "१",
      "lines": [
        "श्रीमन्त हनुमंत मार्तरिपुभिः भूभृत्त तरुभ्राजितं",
        "चाल्यद्-बालधिबंध-वैरिनिचयं चामीकर-आद्रीप्रभम् ।",
        "अष्टौ रक्त पिशंग नेत्रनलिनं भ्रूभंगमंग-स्फुरत्",
        "प्रोद्यच्चंड मयुखमंडल-मुखं दु:खापहं दु:खिनाम् ॥१॥"
      ]
    },
    {
      "type": "verse",
      "number": "२",
      "lines": [
        "कौपीनं कटिसुत्र मौंजजिनयुक्त देहं",
        "विदेहात्मजा-प्राणाधीश-पद-अरविंद-निरतं स्वान्तं कृतान्तं द्विषाम् ।",
        "ध्यात्वैवं समरांगण स्थित मथानीय स्वहृत्पंकजे",
        "संपूज्य अखिल पुजनोक्त विधिनां संप्रार्थयेत् प्रार्थितम् ॥२॥"
      ]
    },
    {
      "type": "verse",
      "number": "३",
      "lines": [
        "ॐ हनुमन् अंजनीसूनो! महाबल पराक्रम।",
        "लोलल्लांगूलपातेन ममारातीन् निपातय ॥३॥"
      ]
    },
    {
      "type": "verse",
      "number": "४",
      "lines": [
        "मर्कटाधिप! मार्तंड-मंडलग्रास कारक।",
        "लोलल्लांगूल-पातेन ममारातीन् निपातय ॥४॥"
      ]
    },
    {
      "type": "verse",
      "number": "५",
      "lines": [
        "अक्षक्षपण पिंगाक्ष! क्षितिशोक क्षयंकर।",
        "लोलल्लांगूल-पातेन ममारातीन् निपातय ॥५॥"
      ]
    },
    {
      "type": "verse",
      "number": "६",
      "lines": [
        "रुद्रावतार! संसार-दु:ख-भार-अपहारक।",
        "लोलल्लांगूल-पातेन ममारातीन् निपातय ॥६॥"
      ]
    },
    {
      "type": "verse",
      "number": "७",
      "lines": [
        "श्रीरामचरणां-भोजमधुपायित-मानस।",
        "लोलल्लांगूल-पातेन ममारातीन् निपातय ॥७॥"
      ]
    },
    {
      "type": "verse",
      "number": "८",
      "lines": [
        "वालिकोपद्रव-क्लांत सुग्रीवोन् मोचन प्रभो।",
        "लोलल्लांगूल-पातेन ममारातीन् निपातय ॥८॥"
      ]
    },
    {
      "type": "verse",
      "number": "९",
      "lines": [
        "सीताविरह-वारीश-मग्न-सीतेशतारक।",
        "लोलल्लांगूल-पातेन ममारातीन् निपातय ॥९॥"
      ]
    },
    {
      "type": "verse",
      "number": "१०",
      "lines": [
        "रक्षोराज-प्रतापाग्नि-दह्यमान-जगध्दन।",
        "लोलल्लांगूल-पातेन ममारातीन् निपातय ॥१०॥"
      ]
    },
    {
      "type": "verse",
      "number": "११",
      "lines": [
        "ग्रस्ताशेष-जगत्स्वास्थ्य-राक्षस-अंभोधिमंद।",
        "लोलल्लांगूल-पातेन ममारातीन् निपातय ॥११॥"
      ]
    },
    {
      "type": "verse",
      "number": "१२",
      "lines": [
        "पुच्छ-गुच्छ-स्फुरद्धूम-अनल-दग्धारिपत्तन।",
        "लोलल्लांगूल-पातेन ममारातीन् निपातय ॥१२॥"
      ]
    },
    {
      "type": "verse",
      "number": "१३",
      "lines": [
        "जगन्मनो-दुरुलंघ्य-पारावार-विलंघन।",
        "लोलल्लांगूल-पातेन ममारातीन् निपातय ॥१३॥"
      ]
    },
    {
      "type": "verse",
      "number": "१४",
      "lines": [
        "स्मृतमात्र-समस्तेष्ट-पूरक-प्रणतप्रिय।",
        "लोलल्लांगूल-पातेन ममारातीन् निपातय ॥१४॥"
      ]
    },
    {
      "type": "verse",
      "number": "१५",
      "lines": [
        "रात्रिंचर-चमूराशि-कर्तनैक-विकर्तन।",
        "लोलल्लांगूल-पातेन ममारातीन् निपातय ॥१५॥"
      ]
    },
    {
      "type": "verse",
      "number": "१६",
      "lines": [
        "जानकी-जानकीजानि-प्रेमपात्र-परंतप।",
        "लोलल्लांगूल-पातेन ममारातीन् निपातय ॥१६॥"
      ]
    },
    {
      "type": "verse",
      "number": "१७",
      "lines": [
        "भीमादिक-महावीर-वीरवेश-अवतारक।",
        "लोलल्लांगूल-पातेन ममारातीन् निपातय ॥१७॥"
      ]
    },
    {
      "type": "verse",
      "number": "१८",
      "lines": [
        "वैदेहि-विरहक्लांत-रामरौषेक-विग्रह।",
        "लोलल्लांगूल-पातेन ममारातीन् निपातय ॥१८॥"
      ]
    },
    {
      "type": "verse",
      "number": "१९",
      "lines": [
        "वज्रांग-नख-दंष्ट्रेश! वज्रिवज्र-अवकुंठन।",
        "लोलल्लांगूल-पातेन ममारातीन् निपातय ॥१९॥"
      ]
    },
    {
      "type": "verse",
      "number": "२०",
      "lines": [
        "अखर्वगर्व-गंधर्व-पर्वत-उद्भेदन-स्वर।",
        "लोलल्लांगूल-पातेन ममारातीन् निपातय ॥२०॥"
      ]
    },
    {
      "type": "verse",
      "number": "२१",
      "lines": [
        "लक्ष्मणप्राण-संत्राणत्रात: तीक्ष्णकरान्वय।",
        "लोलल्लांगूल-पातेन ममारातीन् निपातय ॥२१॥"
      ]
    },
    {
      "type": "verse",
      "number": "२२",
      "lines": [
        "रामाधि-विप्रयोगार्त-भरतादी-आर्तिनाशन।",
        "लोलल्लांगूल-पातेन ममारातीन् निपातय ॥२२॥"
      ]
    },
    {
      "type": "verse",
      "number": "२३",
      "lines": [
        "द्रोणाचल-समुत्क्षेप-समुत्क्षिप्त-अरिवैभव।",
        "लोलल्लांगूल-पातेन ममारातीन् निपातय ॥२३॥"
      ]
    },
    {
      "type": "verse",
      "number": "२४",
      "lines": [
        "सीताशीर्वाद-संपन्न समस्त-अवयवअक्षत।",
        "लोलल्लांगूल-पातेन ममारातीन् निपातय ॥२४॥"
      ]
    },
    {
      "type": "verse",
      "number": "२५",
      "lines": [
        "इति एवम् अश्वत्थतल-उपविष्ट: शत्रुंजयं नाम पठेत् स्तवं य: ।",
        "स-शीघ्रमेव-अस्त-समस्तशत्रु: प्रमोदते मारुतज्-प्रसादात् ॥२५॥"
      ]
