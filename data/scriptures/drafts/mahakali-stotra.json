      "type": "heading",
      "lines": [
        "१७. ॥ श्री महाकाली स्तोत्र ॥"
      ]
    },
    {
      "type": "verse",
      "number": "१",
      "lines": [
        "प्रात: स्मरामि भवभीतिहरां सुरेशीं ।",
        "कालीकृपार्थनयनां नवमेघवर्णम् ॥",
        "सूर्येन्दुवन्हिनयनां भृकुटीकरालाम् ।",
        "सृक्प्रवाहरुचिरां नरमुण्डमालां ॥१॥"
      ]
    },
    {
      "type": "verse",
      "number": "२",
      "lines": [
        "प्रातर्नमामि शिवरुपशवोपविष्टाम् ।",
        "मारप्रयुद्धकरकांचि विभूषिताङ्गीम् ॥",
        "मुण्डां भजे वरमसि दधतीं कराब्जै ।",
        "कर्णावतंसशवयुग्म किशोर भूषणाम् ॥२॥"
      ]
    },
    {
      "type": "verse",
      "number": "३",
      "lines": [
        "प्रातर्भजामि निजभक्तिवरप्रदात्री ।",
        "धात्रीं समस्तजगतां द्रुतवाक्यदात्रीं ॥",
        "पंचत्रिकोणनिलये कुरु सामरस्ये ।",
        "आद्येच शक्तिनिकरे स्मितिभि: परिताम् ॥३॥"
      ]
    },
    {
      "type": "verse",
      "number": "४",
      "lines": [
        "प्रात: स्मरामि वसु यत्र सरोजमध्ये ।",
        "ब्रह्मादिमातृ वसुभैरव भैरविभि: ॥",
        "इंद्रादिवज्रकिरण: स्थितिगेहवित्तां ।",
        "स्वागेषड़ंग युवतिर्दधतीं करालाम् ॥४॥"
      ]
    },
    {
      "type": "verse",
      "number": "५",
      "lines": [
        "प्रात: स्मरामि पितृकाननमध्यसंस्थाम् ।",
        "देवर्षिवृन्दशवमुण्ड शिवापरिताम् ॥",
        "मायामहासुरहरां शिवरुपिणीं तां ।",
        "कालानुबद्धहृदयां जननीं परां वा ॥५॥"
      ]
    },
    {
      "type": "verse",
      "number": "६",
      "lines": [
        "य: श्लोकपंचकमिदं पठति प्रभाते ।",
        "कालीस्मरत्यनुदिनं भुविभारनम्र: ॥",
        "विद्याविलाससुखभूरि धनं च लब्ध्वा ।",
        "चांते प्रयाति शिवलोकमनन्य लाभ: ॥६॥"
      ]
    },
    {
      "type": "phalashruti",
      "lines": [
        "इति श्री महाकाली स्तोत्रम् ॥ ॥ श्री महाकाल्यार्पणमस्तु ॥"
      ]
    }
  ]
}
