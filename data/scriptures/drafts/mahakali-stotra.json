      "type": "heading",
      "lines": [
        "१७. ॥ श्री महाकाली स्तोत्र ॥"
      ]
    },
    {
      "type": "verse",
      "number": "१",
      "lines": [
        "प्रातः स्मरामि भवभीतिहरां सुरेशीं ।",
        "[अस्पष्ट: उर्वरित ओळी — फोटोवरून बाकी]",
        "॥१॥"
      ]
    },
    {
      "type": "verse",
      "number": "२",
      "lines": [
        "प्रातर्नमामि शिवरूपशवोपविष्टाम् ।",
        "[अस्पष्ट: उर्वरित ओळी — फोटोवरून बाकी]",
        "॥२॥"
      ]
    },
    {
      "type": "verse",
      "number": "३",
      "lines": [
        "प्रातर्भजामि निजभक्तिवरप्रदात्रीं ।",
        "[अस्पष्ट: उर्वरित ओळी — फोटोवरून बाकी]",
        "॥३॥"
      ]
    },
    {
      "type": "verse",
      "number": "४",
      "lines": [
        "प्रातः स्मरामि वसु यत्र सरोजमध्ये ।",
        "[अस्पष्ट: उर्वरित ओळी — फोटोवरून बाकी]",
        "॥४॥"
      ]
    },
    {
      "type": "verse",
      "number": "५",
      "lines": [
        "प्रातः स्मरामि पितृकानन मध्यसंस्थाम् ।",
        "[अस्पष्ट: उर्वरित ओळी — फोटोवरून बाकी]",
        "॥५॥"
      ]
    },
    {
      "type": "verse",
      "number": "६",
      "lines": [
        "यः श्लोकपंचकमिदं पठति प्रभाते ।",
        "[अस्पष्ट: उर्वरित ओळी — फोटोवरून बाकी]",
        "॥६॥"
      ]
    },
    {
      "type": "note",
      "lines": [
        "॥ इति श्री महाकाली स्तोत्रम् श्री महाकल्यार्पणमस्तु ॥"
      ]
    }
  ]
