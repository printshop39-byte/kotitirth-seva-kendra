    {
      "type": "heading",
      "lines": [
        "२१. ॥ चरणीं ठाव घावा ॥ (श्री तुकारामांचा अभंग)"
      ]
    },
    {
      "type": "verse",
      "number": "१",
      "lines": [
        "श्री अनंता मधुसूदना । पद्मनाभा नारायणा ।",
        "जगव्यापका जनार्दना । आनंदघना अविनाशा ॥१॥"
      ]
    },
    {
      "type": "verse",
      "number": "२",
      "lines": [
        "सकळ देवाधिदेवा । कृपाळुवा जी केशवा ।",
        "महानंदा महानुभवा । सदाशिवा सहजरुपा ॥२॥"
      ]
    },
    {
      "type": "verse",
      "number": "३",
      "lines": [
        "चक्रधरा विश्वंभरा । गरुडध्वज करुणाकरा ।",
        "सहस्रपादा सहस्रकरा । क्षीरसागरा शेषशयना ॥३॥"
      ]
    },
    {
      "type": "verse",
      "number": "४",
      "lines": [
        "कमलनयना कमलापति । कामिनी मोहना मदनमूर्ती ।",
        "भवतारका धरित्या क्षिती । वामनमूर्ती त्रिविक्रमा ॥४॥"
      ]
    },
    {
      "type": "verse",
      "number": "५",
      "lines": [
        "अगा ये सगुणा निर्गुणा । जगज्जनित्या जगज्जीवना ।",
        "वसुदेव देवकी नंदना । बाळरांगणा बाळकृष्णा ॥५॥"
      ]
    },
    {
      "type": "verse",
      "number": "६",
      "lines": [
        "तुका आला लोटांगणी । मज ठाव द्यावा जी चरणी ।",
        "हेंचि करी तसे विनवणी । भवबंधनी सोडवावे ॥६॥"
      ]
    }
  ]
}