  "sections": [
    {
      "type": "heading",
      "lines": [
        "२१. ॥ चरणीं ठाव घावा ॥ (श्री तुकारामांचा अभंग)"
      ]
    },
    {
      "type": "verse",
      "number": "१",
      "lines": [
        "श्री अनंता मुधसूदना । पद्मनाभा नारायणा ।",
        "जगव्यापाका जनार्दना । आनंदघना अविनाशा ॥१॥"
      ]
    },
    {
      "type": "verse",
      "number": "२",
      "lines": [
        "सकळ देवाधिदेवा । कृपाळुवा जी केशवा ।",
        "महानंदा महानुभवा । सदाशिवा सहजरुपा ॥२॥"
      ]
    },
    {
      "type": "verse",
      "number": "३",
      "lines": [
        "चक्रधरा विश्वंभरा । गरुडध्वजा करुणाकरा ।",
        "सहस्रपादा सहस्रकरा । क्षीरसागरा शेषशयना ॥३॥"
      ]
    },
    {
      "type": "verse",
      "number": "४",
      "lines": [
        "कमलनयना कमलापति । कामिनी मोहना मदनमूर्ती ।",
        "भवतारका धरितिया क्षिती । वामनपूर्ती त्रिविक्रमा ॥४॥"
      ]
    },
    {
      "type": "verse",
      "number": "५",
      "lines": [
        "अगा ये सुगुणा निर्गुणा । जगज्जनिंत्या जगजीवना ।",
        "वसुदेवकीनंदना । बाळरांगणा, बाळकृष्णा ॥५॥"
      ]
    },
    {
      "type": "verse",
      "number": "६",
      "lines": [
        "तुका आला लोटांगणी । मज ठाव द्यावा जी चरणी ।",
        "हेचि करीतसे विनवणी । भवबंधनी सोडवावे ।",
        "भवबंधनी सोडवावे । भवबंधनी सोडवावे ॥६॥"
      ]
    }
  ]
}