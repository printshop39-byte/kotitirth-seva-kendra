  "sections": [
    {
      "type": "heading",
      "lines": [
        "३४. ॥ पुरुषसूक्त ॥"
      ]
    },
    {
      "type": "verse",
      "number": "१",
      "lines": [
        "हरी ॐ सहस्रशीर्षा पुरुष: सहस्राक्ष: सहस्रपात् ।",
        "सभूमिं विश्वतो वृत्वाऽत्यतिष्ठ दशांगुलम् ॥१॥"
      ]
    },
    {
      "type": "verse",
      "number": "२",
      "lines": [
        "पुरुष एवेदं सर्वं यद्भूतं यच्च भव्यम् ।",
        "उतामृत त्वस्येशानो यदन्नेनातिरोहति ॥२॥"
      ]
    },
    {
      "type": "verse",
      "number": "३",
      "lines": [
        "एतावानस्य महिमाऽतो ज्यायाँश्च पुरुष: ।",
        "पादोऽस्य विश्वाभूतानि त्रिपादस्या मृतंदिवि ॥३॥"
      ]
    },
    {
      "type": "verse",
      "number": "४",
      "lines": [
        "त्रिपादूर्ध्व उदैत्पुरुष: पादोऽस्येहा भवत्पुन: ।",
        "ततो विष्वङ्व्यक्रामत् साशनानशने अभि ॥४॥"
      ]
    },
    {
      "type": "verse",
      "number": "५",
      "lines": [
        "तस्मादि्वराळ जायत विराजो अधिपुरुष: ।",
        "स जातो अत्यरिच्यत पश्चाद् भूमिमथोपुर: ॥५॥"
      ]
    },
    {
      "type": "verse",
      "number": "६",
      "lines": [
        "यत्पुरुषेण हविषा देवा यज्ञमतन्वत ।",
        "वसंतो अस्यासी दाज्यं ग्रीष्म इध्म: शरद्धवि: ॥६॥"
      ]
    },
    {
      "type": "verse",
      "number": "७",
      "lines": [
        "तं यज्ञं बर्हिषि प्रौक्षन् पुरुषं जातमग्रत: ।",
        "तेन देवा अयजंत साध्या ऋषयश्चये ॥७॥"
      ]
    },
    {
      "type": "verse",
      "number": "८",
      "lines": [
        "तस्माद् यज्ञात्सर्वहुत: संभृतं पृषदाज्यम् ।",
        "पशूँस्ताँश्चक्रे वायव्यान् आरण्यान् ग्राम्याश्च ये ॥८॥"
      ]
    },
    {
      "type": "verse",
      "number": "९",
      "lines": [
        "तस्माद् यज्ञात्सर्वहुत: ऋच: सामानि जज्ञिरे ।",
        "छंदांसि जज्ञिरे तस्माद् यजुस्तस्माद जायत ॥९॥"
      ]
    },
    {
      "type": "verse",
      "number": "१०",
      "lines": [
        "तस्मादश्वा अजायंत ये के चोभयादत: ।",
        "गावोह जज्ञिरे तस्मात्तस्माज्जाता अजावय: ॥१०॥"
      ]
    },
    {
      "type": "verse",
      "number": "११",
      "lines": [
        "यत्पुरुषं व्यदधु: कतिधा व्यकल्पयन् ।",
        "मुखं किंमस्य कौ बाहू का उरुपादा उच्येते ॥११॥"
      ]
    },
    {
      "type": "verse",
      "number": "१२",
      "lines": [
        "ब्राम्हणोऽस्य मुखमासीद् बाहूराजन्य: कृत: ।",
        "ऊरु तदस्य यद्वैश्य: पद्भ्यां शुद्रो अजायत ॥१२॥"
      ]
    }
  ]
}