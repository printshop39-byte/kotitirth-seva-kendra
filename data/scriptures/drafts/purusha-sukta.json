  "sections": [
    {
      "type": "heading",
      "lines": [
        "३४. ॥ पुरुषसूक्त (संस्कृत) ॥"
      ]
    },
    {
      "type": "verse",
      "number": "१",
      "lines": [
        "हरी ॐ सहस्रशीर्षा पुरुषः सहस्राक्षः सहस्रपात् ।",
        "स भूमिं विश्वतो वृत्वाऽत्यतिष्ठद्दशांङ्गुलम् ॥१॥"
      ]
    },
    {
      "type": "verse",
      "number": "२",
      "lines": [
        "पुरुष एवेदं सर्वं यद् भूतं यच्च भव्यम् ।",
        "उतामृतत्वस्येशानो यदन्नेनातिरोहति ॥२॥"
      ]
    },
    {
      "type": "verse",
      "number": "३",
      "lines": [
        "एतावानस्य महिमाऽतोज्यायाँश्च पूरुषः ।",
        "पादोऽस्य विश्वा भूतानि त्रिपादस्यामृतं दिवि ॥३॥"
      ]
    },
    {
      "type": "verse",
      "number": "४",
      "lines": [
        "त्रिपादूर्ध्व उदैत्पुरुषः पादोऽस्येहाभवत् पुनः ।",
        "ततोऽविष्वङ् व्यत्क्रामत् साशनानशने अभि ॥४॥"
      ]
    },
    {
      "type": "verse",
      "number": "५",
      "lines": [
        "तस्माद्विराळ जायत विराजो अधिपुरुषः ।",
        "स जातो अत्यरिच्यत पश्चाद्भूमिमथो पुरः ॥५॥"
      ]
    },
    {
      "type": "verse",
      "number": "६",
      "lines": [
        "यत् पुरुषेण हविषा देवा यज्ञमतन्वत ।",
        "वसन्तो अस्यासीद् आज्यं ग्रीष्म इध्मः शरद्धविः ॥६॥"
      ]
    },
    {
      "type": "verse",
      "number": "७",
      "lines": [
        "तं यज्ञं बर्हिषि प्रौक्षन् पुरुषं जातमग्रतः ।",
        "तेन देवा अयजन्त साध्या ऋषयश्च ये ॥७॥"
      ]
    },
    {
      "type": "verse",
      "number": "८",
      "lines": [
        "तस्माद्यज्ञात्सर्वहुतः सम्भृतं पृषदाज्यम् ।",
        "पशून्ताँश्चक्रे वायव्यान् आरण्यान् ग्राम्याश्च ये ॥८॥"
      ]
    },
    {
      "type": "verse",
      "number": "९",
      "lines": [
        "तस्माद्यज्ञात्सर्वहुतः ऋचः सामानि जज्ञिरे ।",
        "छन्दांसि जज्ञिरे तस्माद्यजुस्तस्माद जायत ॥९॥"
      ]
    },
    {
      "type": "verse",
      "number": "१०",
      "lines": [
        "तस्मादश्वा अजायन्त ये के चोभयादतः ।",
        "गावो ह जज्ञिरे तस्मात् तस्माज्जाता अजावयः ॥१०॥"
      ]
    },
    {
      "type": "verse",
      "number": "११",
      "lines": [
        "यत् पुरुषं व्यदधुः कतिधा व्यकल्पयन् ।",
        "मुखं किमस्य कौ बाहू का उरु पादा उच्येते ॥११॥"
      ]
    },
    {
      "type": "verse",
      "number": "१२",
      "lines": [
        "ब्राह्मणोऽस्य मुखमासीद् बाहूराजन्यः कृतः ।",
        "उरु तदस्य यद्वैश्यः पद्भ्यां शूद्रो अजायत ॥१२॥"
      ]
    },
    {
      "type": "verse",
      "number": "१३",
      "lines": [
        "चन्द्रमा मनसो जातश्चक्षोः सूर्यो अजायत ।",
        "मुखादिन्द्रश्चाग्निश्च प्राणाद्वायुरजायत ॥१३॥"
      ]
    },
    {
      "type": "verse",
      "number": "१४",
      "lines": [
        "नाभ्या आसीदन्तरिक्षं शीर्ष्णो द्यौः समवर्तत ।",
        "पद्भ्यां भूमिर्दिशः श्रोत्रात् तथा लोकाँ अकल्पयन् ॥१४॥"
      ]
    },
    {
      "type": "verse",
      "number": "१५",
      "lines": [
        "सप्तास्यासन् परिधयः त्रिः सप्त समिधः कृताः ।",
        "देवा यद्यज्ञं तन्वानाः अबध्नन् पुरुषं पशुम् ॥१५॥"
      ]
    },
    {
      "type": "verse",
      "number": "१६",
      "lines": [
        "यज्ञेन यज्ञमयजन्त देवास्तानि धर्माणि प्रथमान्यासन् ।",
        "ते ह नाकं महिमानः सचन्त यत्र पूर्वे साध्याः सन्ति देवाः ॥१६॥"
      ]
    },
    {
      "type": "heading",
      "lines": [
        "फलश्रुती (विष्णु सूक्त)"
      ]
    },
    {
      "type": "verse",
      "number": "१",
      "lines": [
        "हरी ॐ अतो देवा अवन्तु नो यतो विष्णुर्विचक्रमे ।",
        "पृथिव्याः सप्त धामभिः ॥१॥"
      ]
    },
    {
      "type": "verse",
      "number": "२",
      "lines": [
        "इदं विष्णुर्विचक्रमे त्रेधा निदधे पदं समूळ्हमस्य पांसुरे ॥२॥"
      ]
    },
    {
      "type": "verse",
      "number": "३",
      "lines": [
        "त्रिणि पदा विचक्रमे विष्णुर्गोपा अदाभ्यः। अतो धर्माणि धारयन् ॥३॥"
      ]
    },
    {
      "type": "verse",
      "number": "४",
      "lines": [
        "विष्णोः कर्माणि पश्यत यतो व्रतानी पस्पशे ।",
        "इन्द्रस्य युज्यः सखा ॥४॥"
      ]
    },
    {
      "type": "verse",
      "number": "५",
      "lines": [
        "तद्विष्णोः परमं पदं सदा पश्यन्ति सूरयः। दिवीव चक्षुरा ततम् ॥५॥"
      ]
    },
    {
      "type": "verse",
      "number": "६",
      "lines": [
        "तद्विप्रासो विपन्यवो जागृवांसः समिन्धते ।",
        "विष्णोर्यत् परमं पदम् ॥६॥"
      ]
    },
    {
      "type": "heading",
      "lines": [
        "शांती मंत्र"
      ]
    },
    {
      "type": "mantra",
      "lines": [
        "ॐ देवस्य त्वा सवितुः प्रसवेऽश्विनोर्बाहुभ्यां पूष्णो हस्ताभ्या अग्रेस्तेजसा",
        "सूर्यस्य वर्चसे न्द्रस्येंद्रियेणाभिषिंचाभि। बलाय श्रियै यशसेन्नाद्याय।",
        "ॐ भुर्भवः स्वः अमृताभिषेकोऽस्तु। शान्तिः पुष्टिस्तुष्टिश्चास्तु॥",
        "ॐ शांति: शांति: शांति: ॥"
      ]
    }
  ]
}
