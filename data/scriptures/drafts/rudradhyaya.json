      "number": "८",
      "lines": [
        "नम: पाँसव्याय च रजस्याय च ॥८॥"
      ]
    },
    {
      "type": "verse",
      "number": "९",
      "lines": [
        "नम: शुष्क्याय च हरित्याय च ॥९॥"
      ]
    },
    {
      "type": "verse",
      "number": "१०",
      "lines": [
        "नमो लोप्याय चोलप्याय च ॥१०॥"
      ]
    },
    {
      "type": "verse",
      "number": "११",
      "lines": [
        "नम ऊर्व्याय च सूर्म्याय च ॥११॥"
      ]
    },
    {
      "type": "verse",
      "number": "१२",
      "lines": [
        "नम: पर्ण्याय च पर्णशद्याय च ॥१२॥"
      ]
    },
    {
      "type": "verse",
      "number": "१३",
      "lines": [
        "नमोऽपगुरमाणाय चाभिघ्नते च ॥१३॥"
      ]
    },
    {
      "type": "verse",
      "number": "१४",
      "lines": [
        "नम आखिदते च प्रखिदते च ॥१४॥"
      ]
    },
    {
      "type": "verse",
      "number": "१५",
      "lines": [
        "नमो वः किरिकेभ्यो देवानाँ हृदयेभ्यो ॥१५॥"
      ]
    },
    {
      "type": "verse",
      "number": "१६",
      "lines": [
        "नमो विक्षीणकेभ्यो ॥१६॥"
      ]
    },
    {
      "type": "verse",
      "number": "१७",
      "lines": [
        "नमो विचिन्वत्केभ्यो ॥१७॥"
      ]
    },
    {
      "type": "verse",
      "number": "१८",
      "lines": [
        "नम आनिर्हतेभ्यो ॥१८॥"
      ]
    },
    {
      "type": "verse",
      "number": "१९",
      "lines": [
        "नम आमीवत्केभ्यः ॥१९॥"
      ]
    },
    {
      "type": "heading",
      "lines": [
        "नमक — अनुवाक दहावा"
      ]
    },
    {
      "type": "verse",
      "number": "१",
      "lines": [
        "द्रापे अन्धसस्पते दरिद्रन्नीललोहित ।",
        "एषां पुरुषाणामेषां पशूनां मा भेर्माऽरो मो एषां किं चनाऽऽममत् ॥१॥"
      ]
    },
    {
      "type": "verse",
      "number": "२",
      "lines": [
        "या ते रुद्र शिवा तनू: शिवा विश्वाहभेषजी ।",
        "शिवा रुद्रस्य भेषजी तया नो मृड जीवसे ॥२॥"
      ]
    },
    {
      "type": "verse",
      "number": "३",
      "lines": [
        "इमाँ रुद्राय तवसे कपर्दिने क्षयद्वीराय प्र भरामहे मतिम् ।",
        "यथा न: शमसद् द्विपदे चतुष्पदे विश्वं पुष्टं ग्रामे अस्मिन्ननातुरम् ॥३॥"
      ]
    },
    {
      "type": "verse",
      "number": "४",
      "lines": [
        "मृडा नो रुद्रोत नो मयस्कृधि क्षयद्वीराय नमसा विधेम ते ।",
        "यच्छं च योश्च मनुरायजे पिता तदश्याम तव रुद्र प्रणीतौ ॥४॥"
      ]
    },
    {
      "type": "verse",
      "number": "५",
      "lines": [
        "मा नो महान्तमुत मा नो अर्भकं मा न उक्षन्तमुत मा न उक्षितम् ।",
        "मा नो वधी: पितरं मौत मातरं प्रिया मा नस्तनुवो रुद्र रीरिष: ॥५॥"
      ]
    },
    {
      "type": "verse",
      "number": "६",
      "lines": [
        "मा नस्तोके तनये मा न आयुषि मा नो गोषु मा नो अश्वेषु रीरिष: ।",
        "वीरान् मा नो रुद्र भामितो वधीर्हविष्मंतो नमसा विधेम ते ॥६॥"
      ]
    },
    {
      "type": "verse",
      "number": "७",
      "lines": [
        "आरात्ते गोघ्न उत पूरुषघ्ने क्षयद्वीराय सुम्नमस्मे ते अस्तु ।",
        "रक्षा च नो अधि च देव ब्रूह्यधा च न: शर्म यच्छ द्विबर्हा: ॥७॥"
      ]
    },
    {
      "type": "verse",
      "number": "८",
      "lines": [
        "स्तुहि श्रुतं गर्तसदं युवानं मृगं न भीममुपहत्नुमुग्रम् ।",
        "मृडा जरित्रे रुद्र स्तवानो अन्यं ते अस्मन्नि वपन्तु सेना: ॥८॥"
      ]
    },
    {
      "type": "verse",
      "number": "९",
      "lines": [
        "परिणो रुद्रस्य हेतिर्वृणक्तु परि त्वेषस्य दुर्मतिरघायो: ।",
        "अव स्थिरा मघवद्भ्यस्तनुष्व मीढ्वस्तोकाय तनयाय मृडय ॥९॥"
      ]
    },
    {
      "type": "verse",
      "number": "१०",
      "lines": [
        "मीढुष्टम शिवतम शिवो न: सुमना भव ।",
        "परमे वृक्ष आयुधं निधाय कृत्तिं वसान आ चर पिनाकं बिभ्रदा गहि ॥१०॥"
      ]
    },
    {
      "type": "verse",
      "number": "११",
      "lines": [
        "विकिरिद विलोहित नमस्ते अस्तु भगव: ।",
        "यास्ते सहस्रँ हेतयोऽन्यमस्मन्निवपन्तु ता: ॥११॥"
      ]
    },
    {
      "type": "verse",
      "number": "१२",
      "lines": [
        "सहस्राणि सहस्रधा बाहुवोस्तव हेतय: ।",
        "तासामीशानो भगव: पराचीना मुखा कृधि ॥१२॥"
      ]
    },
    {
      "type": "heading",
      "lines": [
        "नमक — अनुवाक अकरावा"
      ]
    },
    {
      "type": "verse",
      "number": "१",
      "lines": [
        "सहस्राणि सहस्रशो ये रुद्रा अधि भूम्याम् ।",
        "तेषाँ सहस्रयोजनेऽव धन्वानि तन्मसि ॥१॥"
      ]
    },
    {
      "type": "verse",
      "number": "२",
      "lines": [
        "अस्मिन्महत्यर्णवेऽन्तरिक्षे भवा अधि ।",
        "तेषाँ सहस्रयोजनेऽव धन्वानि तन्मसि ॥२॥"
      ]
    },
    {
      "type": "verse",
      "number": "३",
      "lines": [
        "नीलग्रीवा: शितिकण्ठा: शर्वा अध: क्षमाचरा: ।",
        "तेषाँ सहस्रयोजनेऽव धन्वानि तन्मसि ॥३॥"
      ]
    },
    {
      "type": "verse",
      "number": "४",
      "lines": [
        "नीलग्रीवा: शितिकण्ठा दिवँ रुद्रा उपश्रिता: ।",
        "तेषाँ सहस्रयोजनेऽव धन्वानि तन्मसि ॥४॥"
      ]
    },
    {
      "type": "verse",
      "number": "५",
      "lines": [
        "ये वृक्षेषु सस्पिञ्जरा नीलग्रीवा विलोहिता: ।",
        "तेषाँ सहस्रयोजनेऽव धन्वानि तन्मसि ॥५॥"
      ]
    },
    {
      "type": "verse",
      "number": "६",
      "lines": [
        "ये भूतानामधिपतयो विशिखास: कपर्दिन: ।",
        "तेषाँ सहस्रयोजनेऽव धन्वानि तन्मसि ॥६॥"
      ]
    },
    {
      "type": "verse",
      "number": "७",
      "lines": [
        "ये अन्नेषु विविध्यन्ति पात्रेषु पिबतो जनान् ।",
        "तेषाँ सहस्रयोजनेऽव धन्वानि तन्मसि ॥७॥"
      ]
    },
    {
      "type": "verse",
      "number": "८",
      "lines": [
        "ये पथां पथिरक्षय ऐलबृदा यव्युध: ।",
        "तेषाँ सहस्रयोजनेऽव धन्वानि तन्मसि ॥८॥"
      ]
    },
    {
      "type": "verse",
      "number": "९",
      "lines": [
        "ये तीर्थानि प्रचरन्ति सृकावन्तो निषङ्गिण: ।",
        "तेषाँ सहस्रयोजनेऽव धन्वानि तन्मसि ॥९॥"
      ]
    },
    {
      "type": "verse",
      "number": "१०",
      "lines": [
        "य एतावन्तश्च भूयाँसश्च दिशो रुद्रा वितस्थिरे ।",
        "तेषाँ सहस्रयोजनेऽव धन्वानि तन्मसि ॥१०॥"
      ]
    },
    {
      "type": "verse",
      "number": "११",
      "lines": [
        "नमो रुद्रेभ्यो ये पृथिव्याँ येऽन्तरिक्षे ये दिवि येषामन्नं वातो वर्षमिषवस्तेभ्यो दश: प्राचीर्दश दक्षिणा",
        "दश: प्रतीचीर्दशोदीचीर्दशोर्ध्वास्तेभ्यो नमस्ते नो मृडयन्तु ते यं द्विष्मो यश्च नो द्वेष्टि तं वो जम्भे दधामि ॥११॥"
      ]
    },
    {
      "type": "heading",
      "lines": [
        "चमक विभाग"
      ]
    },
    {
      "type": "mantra",
      "lines": [
        "ॐ अग्नाविष्णू सजोषसेमा वर्धन्तु वां गिर: ।",
        "द्युम्नैर्वाजेभिरागतम् ॥"
      ]
    },
    {
      "type": "heading",
      "lines": [
        "चमक — अनुवाक पहिला"
      ]
    },
    {
      "type": "prose",
      "number": "१",
      "lines": [
        "ॐ वाजश्च मे प्रसवश्च मे प्रयतिश्च मे प्रसितिश्च मे धीतिश्च मे क्रतुश्च मे स्वरश्च मे श्लोकश्च मे श्रावश्च मे श्रुतिश्च मे ज्योतिश्च मे सुवश्च मे प्राणश्च मेऽपानश्च मे व्यानश्च मेऽसुश्च मे चित्तं च म आधीतं च मे वाक् च मे मनश्च मे चक्षुश्च मे श्रोत्रं च मे दक्षश्च मे बलं च म ओजश्च मे सहश्च म आयुश्च मे जरा च म आत्मा च मे तनूश्च मे शर्म च मे वर्म च मेऽङ्गानि च मेऽस्थानि च मे परूँषि च मे शरीराणि च मे ॥१॥"
      ]
    },
    {
      "type": "heading",
      "lines": [
        "चमक — अनुवाक दुसरा"
      ]
    },
    {
      "type": "prose",
      "number": "२",
      "lines": [
        "ज्यैष्ठ्यं च म आधिपत्यं च मे मन्युश्च मे भामश्च मेऽमश्च मेऽम्भश्च मे जेमा च मे महिमा च मे वरिमा च मे प्रथिमा च मे वर्ष्मा च मे द्राघुया च मे वृध्दं च मे वृध्दिश्च मे सत्यं च मे श्रध्दा च मे जगच्च मे धनं च मे वशश्च मे त्विषिश्च मे क्रीडा च मे मोदश्च मे जातं च मे जनिष्यमाणं च मे सूक्तं च मे सुकृतं च मे वित्तं च मे वेद्यं च मे भूतं च मे भविष्यच्च मे सुगं च मे सुपथं च म ऋद्धं च म ऋद्धिश्च मे क्लृप्तं च मे क्लृप्तिश्च मे मतिश्च मे सुमतिश्च मे ॥२॥"
      ]
    },
    {
      "type": "heading",
      "lines": [
        "चमक — अनुवाक तिसरा"
      ]
    },
    {
      "type": "prose",
      "number": "३",
      "lines": [
        "शं च मे मयश्च मे प्रियं च मेऽनुकामश्च मे कामश्च मे सौमनसश्च मे भद्रं च मे श्रेयश्च मे वस्यश्च मे यशश्च मे भगश्च मे द्रविणं च मे यन्ता च मे धर्ता च मे क्षेमश्च मे धृतिश्च मे विश्वं च मे महश्च मे संविच्च मे ज्ञात्रं च मे सूश्च मे प्रसूश्च मे सीरं च मे लयश्च म ऋतं च मेऽमृतं च मे यक्ष्मं च मेऽनामयच्च मे जीवातुश्च मे दीर्घायुत्वं च मेऽनमित्रं च मेऽभयं च मे सुगं च मे शयनं च मे सूषा च मे सुदिनं च मे ॥३॥"
      ]
    },
    {
      "type": "heading",
      "lines": [
        "चमक — अनुवाक चवथा"
      ]
    },
    {
      "type": "prose",
      "number": "४",
      "lines": [
        "ऊर्क् च मे सूनृता च मे पयश्च मे रसश्च मे घृतं च मे मधु च मे सग्धिश्च मे सपीतिश्च मे कृषिश्च मे वृष्टिश्च मे जैत्रं च म औद्भिद्यं च मे रयिश्च मे रायश्च मे पुष्टं च मे पुष्टिश्च मे विभु च मे प्रभु च मे बहु च मे भूयश्च मे पूर्णं च मे पूर्णतरं च मेऽक्षितिश्च मे कूयवाश्च मेऽन्नं च मेऽक्षुच्च मे व्रीहयश्च मे यवाश्च मे माषाश्च मे तिलाश्च मे मुद्गाश्च मे खल्वाश्च मे गोधूमाश्च मे मसुराश्च मे प्रियङ्गवश्च मेऽणवश्च मे श्यामाकाश्च मे नीवाराश्च मे ॥४॥"
      ]
    },
    {
      "type": "heading",
      "lines": [
        "चमक — अनुवाक पाचवा"
      ]
    },
    {
      "type": "prose",
      "number": "५",
      "lines": [
        "अश्मा च मे मृत्तिका च मे गिरयश्च मे पर्वताश्च मे सिकताश्च मे वनस्पतयश्च मे हिरण्यं च मेऽयश्च मे सीसं च मे त्रपुश्च मे श्यामं च मे लोहं च मेऽग्निश्च म आप: च मे वीरुधश्च म ओषधयश्च मे कृष्टपच्यं च मेऽकृष्टपच्यं च मे ग्राम्याश्च मे पशव आरण्याश्च यज्ञेन कल्पन्तां वित्तं च मे वित्तिश्च मे भूतं च मे भूतिश्च मे वसु च मे वसतिश्च मे कर्म च मे शक्तिश्च मेऽर्थश्च म एमश्च म इतिश्च मे गतिश्च मे ॥५॥"
      ]
    },
    {
      "type": "heading",
      "lines": [
        "चमक — अनुवाक सहावा"
      ]
    },
    {
      "type": "prose",
      "number": "६",
      "lines": [
        "अग्निश्च म इन्द्रश्च मे सोमश्च म इन्द्रश्च मे सविता च म इन्द्रश्च मे सरस्वती च म इन्द्रश्च मे पूषा च म इन्द्रश्च मे बृहस्पतिश्च म इन्द्रश्च मे मित्रश्च म इन्द्रश्च मे वरुणश्च म इन्द्रश्च मे त्वष्टा च म इन्द्रश्च मे धाता च म इन्द्रश्च मे विष्णुश्च म इन्द्रश्च मेऽश्विनौ च म इन्द्रश्च मे मरुतश्च म इन्द्रश्च मे विश्वे च मे देवा इन्द्रश्च मे पृथिवी च म इन्द्रश्च मेऽन्तरिक्षं च म इन्द्रश्च मे द्यौश्च म इन्द्रश्च मे दिशश्च म इन्द्रश्च मे मूर्धा च म इन्द्रश्च मे प्रजापतिश्च म इन्द्रश्च मे ॥६॥"
      ]
    },
    {
      "type": "heading",
      "lines": [
        "चमक — अनुवाक सातवा"
      ]
    },
    {
      "type": "prose",
      "number": "७",
      "lines": [
