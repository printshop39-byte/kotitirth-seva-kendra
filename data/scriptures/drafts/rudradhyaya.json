    {
      "type": "verse",
      "number": "१",
      "lines": [
        "ॐ नमस्ते रुद्र मन्यव उतो त इषवे नम: ।",
        "नमस्ते अस्तु धन्वने बाहुभ्यामुत ते नम: ॥१॥"
      ]
