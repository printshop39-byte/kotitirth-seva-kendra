    { "type": "verse", "number": "१", "lines": ["जपाकुसुमसंकाशं काश्यपेयं महद्युतिम् ।", "तमोऽरिं सर्वपापघ्नं प्रणतोऽस्मि दिवाकरम् ॥१॥"] },
    { "type": "verse", "number": "२", "lines": ["दधिशङ्खतुषाराभं क्षीरोदार्णवसंभवम् ।", "नमामि शशिनं सोमं शम्भोर्मुकुटभूषणम् ॥२॥"] },
    { "type": "verse", "number": "३", "lines": ["धरणीगर्भसंभूतं विद्युत्कान्तिसमप्रभम् ।", "कुमारं शक्तिहस्तं च मङ्गलं प्रणमाम्यहम् ॥३॥"] },
    { "type": "verse", "number": "४", "lines": ["प्रियङ्गुकलिकाश्यामं रूपेणाप्रतिमं बुधम् ।", "सौम्यं सौम्यगुणोपेतं तं बुधं प्रणमाम्यहम् ॥४॥"] },
    { "type": "verse", "number": "५", "lines": ["देवानां च ऋषीणां च गुरुं काञ्चनसंनिभम् ।", "बुद्धिभूतं त्रिलोकेशं तं नमामि बृहस्पतिम् ॥५॥"] },
    { "type": "verse", "number": "६", "lines": ["हिमकुन्दमृणालाभं दैत्यानां परमं गुरुम् ।", "सर्वशास्त्रप्रवक्तारं भार्गवं प्रणमाम्यहम् ॥६॥"] },
    { "type": "verse", "number": "७", "lines": ["नीलाञ्जनसमाभासं रविपुत्रं यमाग्रजम् ।", "छायामार्तण्डसंभूतं तं नमामि शनैश्चरम् ॥७॥"] },
    { "type": "verse", "number": "८", "lines": ["अर्धकायं महावीर्यं चन्द्रादित्यविमर्दनम् ।", "सिंहिकागर्भसंभूतं तं राहुं प्रणमाम्यहम् ॥८॥"] },
    { "type": "verse", "number": "९", "lines": ["पलाशपुष्पसंकाशं तारकाग्रहमस्तकम् ।", "रौद्रं रौद्रात्मकं घोरं तं केतुं प्रणमाम्यहम् ॥९॥"] },
    { "type": "phalashruti", "lines": [
      "इति व्यासमुखोद्गीतं यः पठेत्सुसमाहितः ।",
      "दिवा वा यदि वा रात्रौ विघ्नशान्तिर्भविष्यति ॥",
      "नरनारीनृपाणां च भवेत् दुःस्वप्ननाशनम् ।",
