  "sections": [
    {
      "type": "heading",
      "lines": [
        "२०. ॥ श्री मारुती स्तोत्र ॥ (शनिवारी)"
      ]
    },
    {
      "type": "verse",
      "number": "१",
      "lines": [
        "भीमरुपी महारुद्रा । वज्रहनुमान मारुती ।",
        "वनारी अंजनीसूता । रामदूता प्रभंजना ॥१॥"
      ]
    },
    {
      "type": "verse",
      "number": "२",
      "lines": [
        "महाबळी प्राणदाता । सकळां उठवी बळे ।",
        "सौख्यकारी दु:खहारी । दूत वैष्णव गायका ॥२॥"
      ]
    },
    {
      "type": "verse",
      "number": "३",
      "lines": [
        "दिनानाथा हरिरूपा । सुंदरा जगदंतरा ।",
        "पातालदेवताहंता । भव्य सिंदूरलेपना ॥३॥"
      ]
    },
    {
      "type": "verse",
      "number": "४",
      "lines": [
        "लोकनाथा जगन्नाथा । प्राणनाथा पुरातना ।",
        "पुण्यवंता पुण्यशीला । पावना परितोषका ॥४॥"
      ]
    },
    {
      "type": "verse",
      "number": "५",
      "lines": [
        "ध्वजांगे उचली बाहो । आवेशे लोटला पुढे ।",
        "काळाग्नि काळरुद्राग्नि । देखतां कापती भये ॥५॥"
      ]
    },
    {
      "type": "verse",
      "number": "६",
      "lines": [
        "ब्रह्मांडे माईली नेणो । आवळे दंतपंगती ।",
        "नेत्राग्नि चालिल्या ज्वाळा । भ्रुकुटी ताठिल्या बळे ॥६॥"
      ]
    },
    {
      "type": "verse",
      "number": "७",
      "lines": [
        "पुच्छ ते मुरडिले माथा । किरिटी कुंडले बरी ।",
        "सुवर्णकटिकांसोटी । घंटा किंकिणि नागरा ॥७॥"
      ]
    },
    {
      "type": "verse",
      "number": "८",
      "lines": [
        "ठकारे पर्वता ऐसा । नेटका सडपातळू ।",
        "चपळांग पाहता मोठे । महाविद्युल्लतेपरी ॥८॥"
      ]
    },
    {
      "type": "verse",
      "number": "९",
      "lines": [
        "कोटिच्या कोटि उड्डाणे । झेपावे उत्तरेकडे ।",
        "मंदाद्रीसारिखा द्रोणू । क्रोधे उत्पाटिला बळे ॥९॥"
      ]
    },
    {
      "type": "verse",
      "number": "१०",
      "lines": [
        "आणिला मागुती नेला । आला गेला मनोगती ।",
        "मनासी टाकिले मागे । गतीसी तुळणा नसे ॥१०॥"
      ]
    },
    {
      "type": "verse",
      "number": "११",
      "lines": [
        "अणुपासोनि ब्रह्मांडाएवढा । होत जातसे ।",
        "तयासी तुळणा कोठे । मेरुमांदार धाकुटे ॥११॥"
      ]
    },
    {
      "type": "verse",
      "number": "१२",
      "lines": [
        "ब्रह्मांडाभोवते वेढे । वज्रपुच्छे करु शके ।",
        "तयासी तुळणा कैची । ब्रह्मांडी पाहता नसे ॥१२॥"
      ]
    },
    {
      "type": "verse",
      "number": "१३",
      "lines": [
        "आरक्त देखिले डोळा । ग्रासिले सूर्यमंडळा ।",
        "वाढतां वाढतां वाढे । भेदिले शून्यमंडळा ॥१३॥"
      ]
    },
    {
      "type": "heading",
      "lines": [
        "— फलश्रुती —"
      ]
    },
    {
      "type": "verse",
      "number": "१४",
      "lines": [
        "धनधान्य पशुवृद्धी । पुत्रपौत्र समग्रही ।",
        "पावती रुपविद्यादि । स्तोत्रपाठे करुनिया ॥१४॥"
      ]
    },
    {
      "type": "verse",
      "number": "१५",
      "lines": [
        "भूतप्रेतसमंधादि । रोगव्याधी समस्तही ।",
        "नासती तूटती चिंता । आनंदे भीमदर्शने ॥१५॥"
      ]
    },
    {
      "type": "verse",
      "number": "१६",
      "lines": [
        "हे धरा पंधराश्लोकी । लाभली शोभली बरी ।",
        "दृढदेहो निसंदेहो । संख्या चंद्रकळा गुणे ॥१६॥"
      ]
    },
    {
      "type": "verse",
      "number": "१७",
      "lines": [
        "रामदासी अग्रगणु । कपिकुळासि मंडणु ।",
        "रामरूपी अंतरात्मा । दर्शने दोष नासती ॥१७॥"
      ]
    },
    {
      "type": "phalashruti",
      "lines": [
        "इति रामदासकृत संकटनिरसनं मारुतीस्तोत्रं संपूर्णम्॥",
        "॥ श्री सीतारामचंद्रार्पणमस्तु ॥"
      ]
    }
  ]
}
