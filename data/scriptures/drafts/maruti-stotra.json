  "sections": [
    {
      "type": "heading",
      "lines": [
        "२०. ॥ श्री मारुती स्तोत्र ॥ (शनिवारी)"
      ]
    },
    {
      "type": "verse",
      "number": "१",
      "lines": [
        "भीमरूपी महारुद्रा वज्र हनुमान मारुती ।",
        "वनारी अंजनीसूता रामदूता प्रभंजना ॥१॥"
      ]
    },
    {
      "type": "verse",
      "number": "२",
      "lines": [
        "महाबळी प्राणदाता सकळां उठवी बळें ।",
        "सौख्यकारी दुःखहारी दूत वैष्णवगायका ॥२॥"
      ]
    },
    {
      "type": "verse",
      "number": "३",
      "lines": [
        "दीनानाथा हरीरुपा सुंदरा जगदंतरा ।",
        "पाताळ देवताहंता भव्य सिंदूर लेपना ॥३॥"
      ]
    },
    {
      "type": "verse",
      "number": "४",
      "lines": [
        "लोकनाथा जगन्नाथा प्राणनाथा पुरातना ।",
        "पुण्यवंता पुण्यशीला पावना परितोषका ॥४॥"
      ]
    },
    {
      "type": "verse",
      "number": "५",
      "lines": [
        "ध्वजांगे उचली बाहो आवेशें लोटला पुढें ।",
        "काळाग्नि काळरुद्राग्नि देखतां कापती भयें ॥५॥"
      ]
    },
    {
      "type": "verse",
      "number": "६",
      "lines": [
        "ब्रह्मांडे माइली नेणों आवळे दंतपंगती ।",
        "नेत्राग्नि चालिल्या ज्वाळा, भ्रुकुटी ताठिल्या बळें ॥६॥"
      ]
    },
    {
      "type": "verse",
      "number": "७",
      "lines": [
        "पुच्छ ते मुरडिले माथां किरीटी कुंडलें बरीं ।",
        "सुवर्ण कटिकासोटी घंटा किंकिणि नागरा ॥७॥"
      ]
    },
    {
      "type": "verse",
      "number": "८",
      "lines": [
        "ठकारे पर्वता ऐसा नेटका सडपातळू ।",
        "चपळांग पाहतां मोठे महाविद्युल्लतेपरी ॥८॥"
      ]
    },
    {
      "type": "verse",
      "number": "९",
      "lines": [
        "कोटिच्या कोटि उड्डाणें झेपावे उत्तरेकडे ।",
        "मंद्राद्रि सारिखा द्रोणू क्रोधे उत्पाटिला बळें ॥९॥"
      ]
    },
    {
      "type": "verse",
      "number": "१०",
      "lines": [
        "आणिला मागुती नेला आला गेला मनोगती ।",
        "मनासी टाकिले मागे गतीसी तुळणा नसे ॥१०॥"
      ]
    },
    {
      "type": "verse",
      "number": "११",
      "lines": [
        "अणूपासोनि ब्रह्मांडाएवढा होत जातसे ।",
        "तयासी तुळणा कोठे मेरुमांदार धाकुटे ॥११॥"
      ]
    },
    {
      "type": "verse",
      "number": "१२",
      "lines": [
        "ब्रह्मांडा भोवते वेढे वज्रपुच्छें करू शके ।",
        "तयासी तुळणा कैंची ब्रह्मांडी पाहता नसे ॥१२॥"
      ]
    },
    {
      "type": "verse",
      "number": "१३",
      "lines": [
        "आरक्त देखिले डोळां ग्रासिले सूर्यमंडळा ।",
        "वाढतां वाढतां वाढे भेदिले शून्य मंडळा ॥१३॥"
      ]
    },
    {
      "type": "heading",
      "lines": [
        "— फलश्रुती —"
      ]
    },
    {
      "type": "verse",
      "number": "१४",
      "lines": [
        "धनधान्य पशुवृद्धि पुत्रपौत्र समग्रही ।",
        "पावती रुपविद्यादि स्तोत्रपाठे करुनियां ॥१४॥"
      ]
    },
    {
      "type": "verse",
      "number": "१५",
      "lines": [
        "भूतप्रेत समंधादि रोगव्याधी समस्तही ।",
        "नासती तूटती चिंता आनंदे भीम दर्शने ॥१५॥"
      ]
    },
    {
      "type": "phalashruti",
      "lines": [
        "॥ इति श्रीरामदासकृत संकटनिरसन मारुती स्तोत्रं संपूर्णम् ॥"
      ]
    }
  ]
}