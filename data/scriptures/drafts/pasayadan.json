  "sections": [
    {
      "type": "heading",
      "lines": [
        "२२. ॥ पसायदान ॥"
      ]
    },
    {
      "type": "verse",
      "number": null,
      "lines": [
        "आता विश्वात्मके देवें । येणे वागयज्ञे तोषावे ।",
        "तोषोनि मज द्यावे । पसायदान हें ॥"
      ]
    },
    {
      "type": "verse",
      "number": null,
      "lines": [
        "जे खळांची व्यंकटी सांडो । तया सत्कर्मी रती वाढो ।",
        "भूतां परस्परे जडो । मैत्र जीवाचे ॥"
      ]
    },
    {
      "type": "verse",
      "number": null,
      "lines": [
        "दुरितांचे तिमिर जावो । विश्व स्वधर्म सूर्यें पाहो ।",
        "जो जे वांछिल तो ते लाहो । प्राणिजात ॥"
      ]
    },
    {
      "type": "verse",
      "number": null,
      "lines": [
        "वर्षत सकळमंगळी । ईश्वर निष्ठांची मांदियाळी ।",
        "अनवरत भूमंडळी । भेटो तयां भूतां ॥"
      ]
    },
    {
      "type": "verse",
      "number": null,
      "lines": [
        "चला कल्पतरुंचे आरव । चेतना चिंतामणीचे गांव ।",
        "बोलते जे अर्णव । पियुषाचे ॥"
      ]
    },
    {
      "type": "verse",
      "number": null,
      "lines": [
        "चंद्रमे जे अलांछन । मार्तंड जे तापहीन ।",
        "ते सर्वांही सदा सज्जन । सोयरे होतु ॥"
      ]
    },
    {
      "type": "verse",
      "number": null,
      "lines": [
        "किंबहुना सर्वसुखी । पूर्ण होवूनी तिहीं लोकी ।",
        "भजिजो आदिपुरुषी । अखंडित ॥"
      ]
    },
    {
      "type": "verse",
      "number": null,
      "lines": [
        "आणि ग्रंथोपजिवियें । विशेषी लोकी इये ।",
        "दृष्टीअदृष्टविजयें । होआवे जी ॥"
      ]
    },
    {
      "type": "verse",
      "number": null,
      "lines": [
        "येथ म्हणे श्री विश्वेशरावो । हा होईल दानपसावो ।",
        "येणें वरें ज्ञानदेवो ।",
        "सुखिया जाहला । सुखिया जाहला । सुखिया जाहला ॥"
      ]
    },
    {
      "type": "phalashruti",
      "lines": [
        "॥ ॐ शांति: शांति: ॥ शांति: ॥"
      ]
    }
  ]
