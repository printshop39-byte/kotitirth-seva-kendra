    {
      "type": "heading",
      "lines": [
        "२४. ॥ ध्यान मंत्र ॥ (तीन वेळा)"
      ]
    },
    {
      "type": "mantra",
      "lines": [
        "क्षणम् आत्मानु संधानं, पापं दहति कोटिश: ॥",
        "अन्यथा पाप विध्वंसं, न भवेत कोटी पुण्यत: ॥"
      ]
    },
    {
      "type": "heading",
      "lines": [
        "२८. ॥ महामृत्युंजय मंत्र ॥"
      ]
    },
    {
      "type": "mantra",
      "lines": [
        "ॐ त्र्यंबकं यजामहे । सुगन्धिं पुष्टिवर्धनम् ।",
        "उर्वारुकमिव बंधनान् मृत्योर्मुक्षीयमामृतात् ॥"
      ]
    },
    {
      "type": "heading",
      "lines": [
        "२७. ॥ ध्यायेन्नित्यम् ॥"
      ]
    },
    {
      "type": "verse",
      "lines": [
        "ध्यायेन्नित्यं महेशं रजतगिरिनिभं चारुचन्द्रावतंसम् ।",
        "[अस्पष्ट: उर्वरित ओळी — पृष्ठ ११/१४ फोटोवरून बाकी]"
      ]
    },
    {
      "type": "heading",
      "lines": [
        "२९. ॥ मौलोचंद्र ॥"
      ]
    },
    {
      "type": "verse",
      "lines": [
        "मौलोचंद्र दलं गलेच गरलं…",
        "[अस्पष्ट: पूर्ण श्लोक — फोटोवरून बाकी]"
      ]
    },
    {
      "type": "heading",
      "lines": [
        "२६. ॥ सामुदायिक प्रार्थना ॥"
      ]
    },
    {
      "type": "mantra",
      "lines": [
        "गुरुर्ब्रह्मा गुरुर्विष्णु: गुरुर्देवो महेश्वरा: ।",
        "गुरु: साक्षात परब्रह्म तस्मै श्री गुरवे नम: ॥"
      ]
    },
    {
      "type": "note",
      "lines": [
        "जयजयकार (फोटो): श्री स्वामी समर्थ महाराज की जय · श्री गुरुदेव दत्त ·",
        "श्री त्र्यंबकेश्वर महाराज की जय · गंगा गोदावरी माता · सद्गुरु प.पू. मोरे दादा…",
        "[अस्पष्ट: पूर्ण क्रम — फोटोवरून तपासा]"
      ]
    }
  ]
