        "२४. ॥ ध्यान मंत्र ॥ (तीन वेळा)"
      ]
    },
    {
      "type": "mantra",
      "lines": [
        "क्षणम् आत्मानु संधानं, पापं दहति कोटिश: ॥",
        "अन्यथा पाप विध्वंसं, न भवेत कोटी पुण्यत: ॥"
      ]
    },
    {
      "type": "heading",
      "lines": [
        "२८. ॥ महामृत्युंजय मंत्र ॥"
      ]
    },
    {
      "type": "mantra",
      "lines": [
        "ॐ त्र्यंबकं यजामहे । सुगन्धिं पुष्टिवर्धनम् ।",
        "उर्वारुकमिव बंधनान् मृत्योर्मुक्षीयमामृतात् ॥"
      ]
    },
    {
      "type": "heading",
      "lines": [
        "२७. ॥ ध्यायेन्नित्यम् ॥"
      ]
    },
    {
      "type": "verse",
      "lines": [
        "ध्यायेनित्यं महेशं रजतगिरिनिभं चारुचंद्रावतंसम् ।",
        "रत्नाकल्पोज्ज्वलांग परशुमृगवराभितिहस्तं प्रसन्नम् ॥",
        "पद्मासिनं समंतात् स्तुतममरगणैर्व्याघ्रकृतिं वसानम् ।",
        "विश्वाद्यं विश्ववंद्यं निखिलभयहरं पंचवक्रं त्रिनेत्रम् ॥"
      ]
    },
    {
      "type": "heading",
      "lines": [
        "२९. ॥ मौलोचंद्र ॥"
      ]
    },
    {
      "type": "verse",
      "lines": [
        "मौलोचंद्र दलं गलेच गरलं जुटेच गंगाजलम् ।",
        "व्यालम् वक्षसी चानलं च नयने शुलं कपालं करे ॥",
        "वामांगे दधतं नमामि सततं प्रालेय शैलात्मजाम् ।",
        "भक्तक्लेशहरं हरं स्मरं हरं कर्पूर गौरं परम् ॥"
      ]
    },
    {
      "type": "heading",
      "lines": [
        "२६. ॥ सामुदायिक प्रार्थना ॥"
      ]
    },
    {
      "type": "mantra",
      "lines": [
        "गुरुर्ब्रह्मा गुरुर्विष्णु: गुरुर्देवो महेश्वरा: ।",
        "गुरु: साक्षात परब्रह्म तस्मै श्री गुरवे नम: ॥"
      ]
