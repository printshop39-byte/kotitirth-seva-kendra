{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "scripture.schema.json",
  "title": "Scripture item (draft or verified)",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "title", "language", "script", "category", "verification", "source", "sections"],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
    },
    "title": { "type": "string", "minLength": 1 },
    "language": { "enum": ["sa", "mr", "hi", "mixed"] },
    "script": { "const": "Devanagari" },
    "category": {
      "enum": ["aarti", "mantra", "stotra", "prarthana", "sukta", "test", "other"]
    },
    "kadhi": { "type": ["string", "null"] },
    "verification": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "verifiedBy", "verifiedDate", "sourceCompared"],
      "properties": {
        "status": { "enum": ["draft", "second-pass", "verified-by-centre"] },
        "verifiedBy": { "type": "string" },
        "verifiedDate": {
          "type": "string",
          "pattern": "^$|^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
        },
        "sourceCompared": { "type": "boolean" }
      }
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["label"],
      "properties": {
        "label": { "type": "string" },
        "sourcePage": { "type": ["number", "null"] },
        "sourceImage": {
          "type": ["string", "null"],
          "description": "Filename only, e.g. p003.jpg. Actual image stays local/gitignored under source/pothi/."
        }
      }
    },
    "sections": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["type", "lines"],
        "properties": {
          "type": {
            "enum": ["heading", "verse", "refrain", "mantra", "prose", "note", "phalashruti"]
          },
          "number": { "type": ["string", "null"] },
          "lines": {
            "type": "array",
            "minItems": 1,
            "items": { "type": "string", "minLength": 1 }
          }
        }
      }
    }
  }
}
